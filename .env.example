# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Strongly recommended for privileged server-side database and Storage operations.
# Keep this server-only. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Admin login. Set ADMIN_PASSWORD on the server for production.
ADMIN_PASSWORD=replace-with-a-long-random-password
# Compatibility fallback for the requested variable. This is a PUBLIC-prefixed
# variable by convention; prefer ADMIN_PASSWORD and never reference it in client code.
NEXT_PUBLIC_ADMIN_PASSWORD=

# Shiprocket API user credentials (create an API user in Shiprocket Settings > API)
SHIPROCKET_EMAIL=your-shiprocket-api-user@example.com
SHIPROCKET_PASSWORD=YOUR_SHIPROCKET_API_PASSWORD
PICKUP_PINCODE=700001
# Optional: must match a pickup location already configured in your Shiprocket account.
SHIPROCKET_PICKUP_LOCATION=Primary

# Razorpay API keys (use Test Mode first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
